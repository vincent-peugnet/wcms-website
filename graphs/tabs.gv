# used for images/graph-example.svg
# Generated with https://edotor.net/ and layout dot
digraph g {
    rankdir=TD;
	bgcolor=transparent;
    content    [shape=tab]
    css        [shape=tab]
    body       [shape=tab]
    javascript [shape=tab]

    content
    css -> cssfile
    body -> render -> HTML
    javascript -> js
    
    cssfile [label="CSS file",shape=note]
    HTML [shape=note]
    js [label="JS file",shape=note]

}
